{
    "manifest_version": 3,
    "name": "PrettyJSON",
    "version": "1.0.4",
    "description": "Format JSON code in browser",
    "author": "Vipin Yadav",
    "homepage_url": "https://vipinyadav.com/",
    "icons": {
        "32": "icon.png",
        "48": "icon48.png",
        "64": "icon64.png",
        "128": "icon128.png",
        "256": "icon256.png"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ]
        }
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "viewer.css"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "default_locale": "en"
}