{
  "compilerOptions": {
    "outDir": "./ts-out/",
    "sourceMap": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "module": "ESNext",
    "target": "es2020",
    "moduleResolution": "bundler",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["chrome"],
    "skipLibCheck": true
  },
  "include": [
    "./src/*.ts"
  ]
}
